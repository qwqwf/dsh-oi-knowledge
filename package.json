{
  "name": "dsh-oi-knowledge",
  "version": "1.3.3",
  "description": "OI/ICPC 知识点树：把题目与题解拆成观察、套路、思路与坑点，维护可自检训练弱点的知识点树，并同步 Codeforces / AtCoder / 洛谷 账号。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "meta": {
    "title": "OI 知识点树",
    "description": "把做过的题拆成观察、套路、思路与坑点，维护可自检弱点的知识点树，并同步 Codeforces / AtCoder / 洛谷 账号。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "oi",
    "icpc",
    "knowledge-tree",
    "training"
  ],
  "license": "MIT"
}
